{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "com-rs validation card",
  "type": "object",
  "required": ["id", "title", "source", "run"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "title": {"type": "string"},
    "literature": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "source": {
      "type": "object",
      "required": ["kind", "reference", "locator"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["paper", "standard", "tool", "closed_form"]},
        "reference": {"type": "string"},
        "locator": {"type": "string"},
        "file": {"type": "string", "pattern": "^[a-z-]+/[^/]+\\.pdf$"},
        "version": {"type": "string"}
      }
    },
    "description": {"type": "string"},
    "run": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "function": {"type": "string", "pattern": "^comrs\\.[A-Za-z_][A-Za-z0-9_]*$"},
        "test": {"type": "string", "pattern": "^validation/tests/[a-z0-9_]+\\.rs(::[a-z0-9_]+)?$"},
        "spec": {"type": "string", "pattern": "^specs/validation/[a-z0-9_]+\\.yaml$"}
      }
    },
    "tier": {"enum": ["ci", "campaign"]},
    "duration": {"type": "string"},
    "output": {"type": ["string", "integer"]},
    "tolerance": {"$ref": "#/$defs/tolerance"},
    "why": {"type": "string"},
    "note": {"type": "string"},
    "findings": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["inputs", "expected"],
        "additionalProperties": false,
        "properties": {
          "inputs": {"type": "object"},
          "expected": {},
          "output": {"type": ["string", "integer"]},
          "tolerance": {"$ref": "#/$defs/tolerance"},
          "why": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"run": {"required": ["spec"]}}},
      "then": {"not": {"required": ["cases"]}},
      "else": {"required": ["cases"]}
    }
  ],
  "$defs": {
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atol": {"type": "number", "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "factor": {"type": "number", "minimum": 1},
        "exact": {"type": "boolean"}
      }
    }
  }
}
